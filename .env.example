# All settings are optional; the values below are the defaults. No secrets are needed.
# Directory containing the built `microfeature` extension module (Makefile sets this for you).
MF_MODULE_DIR=build/python
# Engine parameters. Defaults: benchmark 60000/30000 ms; the ML demo defaults to 600000/300000 ms when unset.
# MF_WINDOW_MS=60000
# MF_HALFLIFE_MS=30000
MF_SHARDS=64
# Benchmark harness sizing.
MF_BENCH_EVENTS=300000
MF_BENCH_KEYS=2000
MF_BENCH_LOOKUPS=20000
MF_BENCH_THREADS=4
# ML demo sizing / determinism.
MF_DEMO_DAYS=4
MF_DEMO_SEED=7
